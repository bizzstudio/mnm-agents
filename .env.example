# אופציה 1 (מומלץ ב-dev): השאר ריק — Vite יעביר /api דרך ה-proxy ל-VITE_BACKEND_PROXY
# VITE_API_BASE_URL=

# אופציה 2 (production / וכאשר ה-backend על דומיין אחר): URL מלא
# VITE_API_BASE_URL=https://api.example.com/api

# יעד ה-proxy של /api ב-dev. ברירת מחדל ב-vite.config.js: http://localhost:3028
VITE_BACKEND_PROXY=http://localhost:3028

VITE_APP_NAME=סוכני מכירות
